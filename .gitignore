# Novos dados e verificações locais não entram no Git.
# Dados e resultados já versionados no baseline continuam preservados.
/data/
/tests/
/docs/
/notebooks/*colab*.ipynb

# Novos pesos, execuções e relatórios. Os resultados rastreados do baseline ficam.
/artifacts/
*.pth
*.ckpt
*.onnx
*.log

# Ambiente, bytecode e caches Python/Jupyter.
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
build/
dist/
*.egg-info/

# Configurações locais, credenciais e arquivos do sistema/editor.
/.agents/
/.codex/
/.aws/
.env
.env.*
!.env.example
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
